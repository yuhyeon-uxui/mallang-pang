{
  "name": "mallang-pang",
  "version": "1.0.3",
  "description": "스트레스 해소용 바탕화면 왁스볼 펫",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.yuhyeon.mallangpang",
    "productName": "말랑팡팡",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "identity": null
    }
  },
  "keywords": [],
  "author": "Yuhyeon",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuhyeon-uxui/mallang-pang.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2"
  },
  "dependencies": {
    "voronoi": "^1.0.0"
  }
}
