{
  "name": "mallang-pang",
  "version": "1.0.1",
  "description": "스트레스 해소용 바탕화면 왁스볼 펫",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win -c.extraMetadata.main=main.js"
  },
  "build": {
    "appId": "com.yuhyeon.mallangpang",
    "productName": "말랑팡팡",
    "directories": {
